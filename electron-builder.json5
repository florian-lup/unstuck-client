// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.unstuck.app',
  asar: true,
  productName: 'Unstuck',
  directories: {
    output: 'release/${version}',
  },
  files: ['dist', 'dist-electron'],
  publish: {
    provider: 'github',
    owner: 'florian-lup',
    repo: 'unstuck-client',
    releaseType: 'release',
    // Publish both full installer and blockmap files for delta updates
    publishAutoUpdate: true,
  },
  mac: {
    target: ['dmg'],
    artifactName: '${productName}-Mac-${version}-Installer.${ext}',
    // Code signing disabled
    identity: null,
  },
  // macOS notarization disabled
  // afterSign: 'build/notarize.js',
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    icon: 'public/unstuck-logo.ico',
    artifactName: '${productName}-Windows-${version}-Setup.${ext}',
    executableName: 'Unstuck',
    // Code signing disabled
    verifyUpdateCodeSignature: false,
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    // Generate delta updates for faster downloads
    differentialPackage: true,
    // Set the installer file icon
    installerIcon: 'public/unstuck-logo.ico',
  },
  linux: {
    target: ['AppImage'],
    artifactName: '${productName}-Linux-${version}.${ext}',
  },
}
