// @see - https://www.electron.build/configuration/configuration
{
  $schema: 'https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json',
  appId: 'com.unstuck.app',
  asar: true,
  productName: 'Unstuck',
  directories: {
    output: 'release/${version}',
  },
  files: ['dist', 'dist-electron'],
  publish: {
    provider: 'github',
    owner: 'florian-lup',
    repo: 'unstuck-client',
    releaseType: 'release',
    // Publish both full installer and blockmap files for delta updates
    publishAutoUpdate: true,
  },
  mac: {
    target: ['dmg'],
    artifactName: '${productName}-Mac-${version}-Installer.${ext}',
    // Code signing configuration for macOS
    hardenedRuntime: true,
    gatekeeperAssess: false,
    entitlements: 'build/entitlements.mac.plist',
    entitlementsInherit: 'build/entitlements.mac.plist',
    // Identity will be auto-discovered from keychain if available
    // Or can be specified via CSC_NAME environment variable
  },
  // macOS notarization - required for distribution outside Mac App Store
  afterSign: 'build/notarize.js',
  win: {
    target: [
      {
        target: 'nsis',
        arch: ['x64'],
      },
    ],
    icon: 'public/unstuck-logo.ico',
    artifactName: '${productName}-Windows-${version}-Setup.${ext}',
    executableName: 'Unstuck',
    // Code signing configuration for Windows
    // Certificate path via CSC_LINK (can be .pfx or .p12)
    // Certificate password via CSC_KEY_PASSWORD
    signingHashAlgorithms: ['sha256'],
    // Specify certificate by subject name (useful for USB tokens like Certum)
    certificateSubjectName: 'Samson-Florian Lup',
    // Verify signature after signing (important for auto-updates)
    verifyUpdateCodeSignature: true,
  },
  nsis: {
    oneClick: false,
    perMachine: false,
    allowToChangeInstallationDirectory: true,
    deleteAppDataOnUninstall: false,
    // Generate delta updates for faster downloads
    differentialPackage: true,
  },
  linux: {
    target: ['AppImage'],
    artifactName: '${productName}-Linux-${version}.${ext}',
  },
}
