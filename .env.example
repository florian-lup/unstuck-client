# Code Signing Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file with real credentials to version control

# ============================================
# WINDOWS CODE SIGNING
# ============================================
# Path to your code signing certificate (.pfx or .p12)
# Can be absolute path or relative to project root
CSC_LINK=path/to/your/certificate.pfx

# Password for the code signing certificate
CSC_KEY_PASSWORD=your_certificate_password

# (Optional) Subject name of the certificate if you have multiple
# WIN_CSC_NAME=Your Company Name

# ============================================
# MACOS CODE SIGNING & NOTARIZATION
# ============================================
# Path to your .p12 certificate file (if not in Keychain)
# CSC_LINK=path/to/your/certificate.p12

# Password for the .p12 certificate
# CSC_KEY_PASSWORD=your_certificate_password

# Or specify the certificate identity name from your Keychain
# CSC_NAME=Developer ID Application: Your Company Name (TEAM_ID)

# Apple ID for notarization
APPLE_ID=your-apple-id@example.com

# App-specific password for notarization
# Generate at: https://appleid.apple.com/account/manage
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Apple Team ID (10-character team identifier)
APPLE_TEAM_ID=XXXXXXXXXX

# ============================================
# GITHUB PUBLISHING (Required for auto-updates)
# ============================================
# GitHub Personal Access Token with 'repo' scope
# Generate at: https://github.com/settings/tokens
# Required permissions: 'repo' (full control of private repositories)
GH_TOKEN=your_github_personal_access_token
